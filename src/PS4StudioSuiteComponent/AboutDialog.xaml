<Window x:Class="PS4Studio.AboutDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PS4 Classics Package Studio" Width="620" Height="620" MinWidth="500" MinHeight="430" WindowStartupLocation="CenterOwner" WindowStyle="None" Background="#141F30" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False" FontFamily="Segoe UI">
  <Border BorderBrush="#35516C" BorderThickness="1" Padding="26">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,20"><TextBlock Text="ABOUT" FontSize="11" FontWeight="Bold" Foreground="#39CEF5"/><TextBlock Text="PS4 Classics Package Studio" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Create PS4 packages from supported PS1 and PS2 disc images. The packaging engine is built in, and available cover art can be cached for offline use." TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#CBD8E6"/>
          <TextBlock Text="Credits &amp; acknowledgments" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,10"/>
          <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="#CBD8E6"><Run FontWeight="SemiBold" Foreground="White" Text="PS Classics fPKG Builder"/><Run Text=" — SvenGDK and contributors, for the packaging workflow, game IDs, LibCrypt data, and PS4 Lua profiles."/></TextBlock>
          <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,10,0,0" Foreground="#CBD8E6"><Run FontWeight="SemiBold" Foreground="White" Text="Widescreen patches"/><Run Text=" — PCSX2 patch authors and contributors."/></TextBlock>
          <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,10,0,0" Foreground="#CBD8E6"><Run FontWeight="SemiBold" Foreground="White" Text="Disc verification"/><Run Text=" — Redump contributors; PS2 catalog snapshot via tsitokely / ps2-iso-renamer."/></TextBlock>
          <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,10,0,0" Foreground="#CBD8E6"><Run FontWeight="SemiBold" Foreground="White" Text="Cover artwork"/><Run Text=" — xlenore and contributors."/></TextBlock>
          <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,10,0,0" Foreground="#CBD8E6"><Run FontWeight="SemiBold" Foreground="White" Text="PS2 manuals"/><Run Text=" — Kirkland’s Manual Labor; matching index from pop-fe2 by Ronnie Sahlberg and contributors."/></TextBlock>
          <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,10,0,0" Foreground="#CBD8E6"><Run FontWeight="SemiBold" Foreground="White" Text="Included tools"/><Run Text=" — PDFium contributors; xdelta3 by Joshua MacDonald and contributors; 7-Zip by Igor Pavlov and contributors; PS2 Classics tools by ps3dev-net, with Cygwin and zlib. PS3 disc format references include OpenBurningSuite by SvenGDK and PS3Dec by al3xtjames, and PS3Dec by Redrrx (Yacine S.) for local key lookup inspiration."/></TextBlock>
          <TextBlock Text="PlayStation and PS4 are products of Sony. Third-party license notices are available below." TextWrapping="Wrap" FontSize="12" LineHeight="20" Foreground="#9EADC0" Margin="0,22,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <DockPanel Grid.Row="2" Margin="0,20,0,0" LastChildFill="False"><Button DockPanel.Dock="Left" Content="View licenses" Click="Licenses_Click" MinWidth="130"/><Button DockPanel.Dock="Left" Content="PS2 tool source" Click="Source_Click" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Style="{StaticResource PrimaryButtonStyle}" IsCancel="True" MinWidth="100"/></DockPanel>
    </Grid>
  </Border>
</Window>
