<Window x:Class="PS4Studio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="PS4StudioIcon.ico" Title="PS4 Classics Package Studio" Width="1080" Height="820" MinWidth="780" MinHeight="650" Background="#0C1421" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"><Window.Resources>        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#294158" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#20374C" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F1723" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                            <ContentPresenter Margin="11,0,40,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#E7EDF5" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="10" Height="5" Stretch="Fill" HorizontalAlignment="Right" Margin="0,0,14,0"
                                  VerticalAlignment="Center" IsHitTestVisible="False" />
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#192638" BorderBrush="#354A62" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ElectricProgress" TargetType="ProgressBar">
          <Setter Property="Tag" Value="{x:Static SystemParameters.ClientAreaAnimation}"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#0C1B2B" BorderBrush="#27455A" BorderThickness="1" CornerRadius="7"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Margin="2" CornerRadius="5" Background="#07C4FF"><Border.Effect><DropShadowEffect Color="#008CFF" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></Border.Effect></Border>
              <Border x:Name="ActiveGlow" Margin="2" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Reflect">
                  <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="ShimmerShift" X="0"/></LinearGradientBrush.RelativeTransform>
                  <GradientStop Color="#007CFF" Offset="0"/><GradientStop Color="#00D9FF" Offset="0.5"/><GradientStop Color="#007CFF" Offset="1"/>
                </LinearGradientBrush></Border.Background>
                <Border.Effect><DropShadowEffect Color="#00AFFF" BlurRadius="15" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="ActiveGlow" Property="Visibility" Value="Visible"/></Trigger>
              <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsIndeterminate" Value="True"/><Condition Property="Tag" Value="True"/></MultiTrigger.Conditions>
                <MultiTrigger.EnterActions><BeginStoryboard x:Name="GlowMotion"><Storyboard><DoubleAnimation Storyboard.TargetName="ShimmerShift" Storyboard.TargetProperty="X" From="-1" To="1" Duration="0:0:2" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions><StopStoryboard BeginStoryboardName="GlowMotion"/></MultiTrigger.ExitActions>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
</Window.Resources>
<Grid Margin="24,20,24,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16" MinHeight="102">
    <Border x:Name="HeaderGlow" BorderThickness="3" CornerRadius="14" IsHitTestVisible="False" Opacity="0.65"><Border.Effect><BlurEffect Radius="9"/></Border.Effect></Border>
    <Border x:Name="HeaderBorder" Background="#141F30" BorderThickness="2" CornerRadius="14" Padding="20,6">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="playstation-logo.png" Width="48" Height="44" Stretch="Uniform" Margin="0,0,18,0" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><TextBlock x:Name="HeaderKicker" Text="PS4 CLASSICS PACKAGE STUDIO" Foreground="#66CDEA" FontSize="10" FontWeight="Bold"/>
        <TextBlock x:Name="HeaderTitle" Text="Your classics, ready for PS4." FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/>
        <TextBlock x:Name="HeaderDescription" Text="Build packages from your PS1 and PS2 disc images." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="About" Click="About_Click" Margin="0,0,0,6"/><Border CornerRadius="8" Background="#20354A" Padding="12,7"><TextBlock x:Name="HeaderBadge" Text="PS1  /  PS2" Foreground="#A5DDF0" FontWeight="SemiBold"/></Border></StackPanel>
    </Grid>
    </Border>
  </Grid>
  <StackPanel x:Name="StudioSwitcher" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="PS4 package builder" Click="ShowBuilder" Margin="0,0,8,0"/><Button Content="PS2 &amp; PS3 Classics" Click="ShowCrypto"/></StackPanel>
  <ScrollViewer x:Name="BuilderView" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,8,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14"><StackPanel>
          <TextBlock Text="01   DISC IMAGES" Foreground="#65CBEA" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="Choose your games" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="Add images to build separately or combine as a multi-disc game." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,13"/>
          <TextBlock Text="GAME SYSTEM" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
          <ComboBox Style="{StaticResource DarkCombo}" Height="40" x:Name="SystemChoice" SelectedIndex="0" Margin="0,6,0,12" SelectionChanged="SystemChanged"><ComboBoxItem Content="PS1 - BIN or raw ISO + CUE"/><ComboBoxItem Content="PS2 - ISO"/></ComboBox>
          <TextBlock Text="PACKAGE MODE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
          <ComboBox x:Name="PackageMode" Style="{StaticResource DarkCombo}" Height="40" SelectedIndex="0" Margin="0,6,0,14"><ComboBoxItem Content="Separate packages (queue)"/><ComboBoxItem Content="One multi-disc package"/></ComboBox>
          <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Remove" Click="RemoveDisc" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="+ Add images" Click="BrowseDisc"/><TextBlock Text="DISC QUEUE" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/></DockPanel>
          <ListBox x:Name="DiscList" Height="125" DisplayMemberPath="Name" SelectionChanged="DiscSelected" AutomationProperties.Name="Disc queue"/>
          <Button x:Name="Verify" Content="Verify discs offline" Click="VerifyDiscs" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Compare supported discs with the bundled Redump database. Click again to cancel."/>
          <TextBlock x:Name="DiscStatus" Text="Disc: waiting" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" ToolTip="Green: files exist and a PS1 CUE passed basic checks. Red: a required file is missing or invalid. This does not check integrity; use Verify discs."/>
          <TextBlock x:Name="AudioStatus" Text="Disc audio: waiting" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" ToolTip="Green: PS1 audio tracks and their files exist. Red: an audio file is missing. Gray: no audio tracks or unknown. This does not test playback."/>
          <TextBlock x:Name="ManualStatus" Text="Manual: waiting" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" ToolTip="Manuals are verified for viewing on this PC; they are not added to the PS4 package."/>
          <TextBlock Text="For multi-disc packages, discs use the order shown above." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0"/>
        </StackPanel></Border>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><StackPanel>
          <TextBlock Text="03   COMPATIBILITY" Foreground="#65CBEA" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="Game settings" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,10"/>
          <TextBlock Text="PS1 OPTIONS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
          <CheckBox x:Name="Analog" Content="Emulate analog controls" Margin="2,9,0,3"/><CheckBox x:Name="SkipBoot" Content="Skip PS1 boot logo" Margin="2,3"/><CheckBox x:Name="Force60" Content="Force 60 Hz" Margin="2,3,0,12"/>
          <TextBlock x:Name="ProtectionStatus" Text="PS1 protection: waiting" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" ToolTip="Recognized PS1 IDs can use the bundled PS4 LibCrypt settings. An unlisted ID does not prove a disc is unprotected."/>
          <DockPanel Margin="0,7,0,4"><Button Content="Choose patch" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowsePatch"/><TextBox x:Name="PatchPath" ToolTip="Optional PPF2, supported PPF3, or xdelta patch for a single PS1 disc"/></DockPanel><TextBlock Text="Optional PS1 patch: one disc per package; the original remains unchanged." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
          <TextBlock Text="PS2 OPTIONS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
          <CheckBox x:Name="AutoProfile" Content="Apply a matching PS2 Lua profile" IsChecked="True" Margin="2,9,0,3" ToolTip="Uses the bundled PS4 profile database. Widescreen or a custom Lua file takes priority."/>
          <TextBlock x:Name="ProfileStatus" Text="● PS2 profile: waiting" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,2,0,4" ToolTip="Profile availability is not a guarantee of gameplay compatibility."/>
          <CheckBox x:Name="Widescreen" Content="Add widescreen patch when available" Margin="2,9,0,3" ToolTip="Matches the PS2 game executable against the toolkit database."><CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="IsEnabled" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=SystemChoice}" Value="1"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox><TextBlock Text="PS2 single-disc packages · checks the exact disc version while building." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="22,0,0,5"/>
          <CheckBox x:Name="DisableMTVU" Content="Disable MTVU" Margin="2,9,0,3"/><CheckBox x:Name="GraphicsFix" Content="Apply graphics compatibility settings" Margin="2,3"/>
          <TextBlock Text="CUSTOM PS4 LUA CONFIG" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,0"/><DockPanel Margin="0,6,0,0"><Button Content="Choose Lua" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseLua"/><TextBox x:Name="LuaPath" ToolTip="Optional PS4 emulator Lua configuration for one disc"/></DockPanel><TextBlock Text="For one disc. PS2 custom Lua and automatic widescreen cannot be combined." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <Button Content="Open PS4 compatibility reports" Click="OpenCompatibility" HorizontalAlignment="Left" Margin="0,8,0,0"/><TextBlock Text="Community reports are online and listed by title and region." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel></Border>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14"><StackPanel>
          <TextBlock Text="02   PACKAGE DETAILS" Foreground="#65CBEA" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="Set up your package" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="Review the title and detected game ID before building." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
          <TextBlock Text="GAME TITLE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="GameTitle" Margin="0,6,0,12" AutomationProperties.Name="Game title"/>
          <TextBlock Text="GAME ID" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="GameId" Margin="0,6,0,4" AutomationProperties.Name="Game ID"/><TextBlock Text="Four letters and five digits" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
          <TextBlock Text="PACKAGING ENGINE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,5"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseToolkit" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="Built-in" Click="UseBuiltIn" Margin="8,0,0,0"/><TextBox x:Name="Toolkit" AutomationProperties.Name="Packaging engine"/></DockPanel><TextBlock Text="The built-in engine works offline; an external toolkit is optional." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12"/>
          <TextBlock Text="OUTPUT FOLDER" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseOutput" Margin="8,0,0,0"/><TextBox x:Name="Output" AutomationProperties.Name="Output folder"/></DockPanel>
        </StackPanel></Border>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><StackPanel>
          <TextBlock Text="04   ARTWORK" Foreground="#65CBEA" FontSize="11" FontWeight="Bold"/><TextBlock Text="Make it yours" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,4"/><TextBlock Text="Optional artwork for the PS4 home screen." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
          <CheckBox x:Name="AutoArtwork" Content="Find missing covers online" IsChecked="True" Checked="ArtworkChanged" Unchecked="ArtworkChanged"/>
          <TextBlock Text="COVER STYLE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,0"/>
          <ComboBox x:Name="CoverStyle" Style="{StaticResource DarkCombo}" Height="40" SelectedIndex="0" Margin="0,6,0,0" SelectionChanged="CoverStyleChanged"><ComboBoxItem Content="Standard cover"/><ComboBoxItem Content="3D cover"/></ComboBox>
          <TextBlock x:Name="ArtworkStatus" Text="● Artwork: waiting" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,8"/>
          <Border x:Name="CoverPreviewFrame" Visibility="Collapsed" Background="#0D1928" BorderBrush="#2A4057" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal"><Image x:Name="CoverPreview" Width="110" Height="140" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="COVER PREVIEW" Foreground="#7FA1BD" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="CoverPreviewLabel" Text="Artwork" Foreground="#EDF4FC" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Used as the package icon" Foreground="#9EADC0" FontSize="11" Margin="0,5,0,0"/></StackPanel></StackPanel>
          </Border>
          <Button Content="Preview PS4 home screen" Click="PreviewHome" HorizontalAlignment="Left" Margin="0,0,0,8"/>
          <TextBlock Text="PACKAGE ICON" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,12"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseIcon" Margin="8,0,0,0"/><TextBox x:Name="IconPath" AutomationProperties.Name="Package icon" TextChanged="ArtworkPathChanged"/></DockPanel>
          <TextBlock Text="BACKGROUND" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseBackground" Margin="8,0,0,0"/><TextBox x:Name="BackgroundPath" AutomationProperties.Name="Package background"/></DockPanel>
          <TextBlock Text="MANUALS · PC PREVIEW" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,0"/><CheckBox x:Name="OnlineManual" Content="Find missing PS2 manuals online" IsChecked="True" Checked="ManualOptionChanged" Unchecked="ManualOptionChanged" Margin="0,7,0,4"/><DockPanel><Button Content="Choose folder" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseManualFolder"/><TextBox x:Name="ManualFolder" TextChanged="ManualFolderChanged" ToolTip="Folder of PS2 manuals named by game ID"/></DockPanel><Button x:Name="ShowManual" Content="Open manual on this PC" Click="OpenManual" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0"/><TextBlock Text="Manuals are for PC viewing and are not added to PS4 packages." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel></Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
  <ScrollViewer x:Name="CryptoView" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,8,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14"><StackPanel>
          <TextBlock Text="01   CONVERSION" Foreground="#65CBEA" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="Choose your image" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="Encrypt or decrypt a PS2 Classics image or a PS3 disc ISO." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
          <TextBlock Text="GAME FORMAT" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
          <ComboBox x:Name="CryptoSystem" AutomationProperties.Name="Game format" Style="{StaticResource DarkCombo}" Height="40" SelectedIndex="0" Margin="0,6,0,12" SelectionChanged="CryptoSystemChanged"><ComboBoxItem Content="PS2 Classics (PS3)"/><ComboBoxItem Content="PS3 disc ISO"/></ComboBox>
          <TextBlock Text="OPERATION" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
          <ComboBox x:Name="CryptoMode" AutomationProperties.Name="Conversion operation" Style="{StaticResource DarkCombo}" SelectedIndex="0" Height="40" Margin="0,6,0,14"><ComboBoxItem Content="Encrypt"/><ComboBoxItem Content="Decrypt"/></ComboBox>
          <TextBlock Text="SOURCE FILE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
          <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Browse" Click="CryptoBrowseSource" Margin="8,0,0,0"/><TextBox x:Name="CryptoSource" AutomationProperties.Name="Source file"/></DockPanel>
          <TextBlock Text="Your original image stays unchanged." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel></Border>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14"><StackPanel>
          <TextBlock Text="02   DESTINATION" Foreground="#65CBEA" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="Save your converted image" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="Choose a new file for the converted image." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
          <TextBlock Text="OUTPUT FILE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
          <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Choose" Click="CryptoBrowseOutput" Margin="8,0,0,0"/><TextBox x:Name="CryptoOutput" AutomationProperties.Name="Output file"/></DockPanel>
          <TextBlock Text="Existing files are never overwritten." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><StackPanel>
          <TextBlock Text="03   DISC KEY" Foreground="#65CBEA" FontSize="11" FontWeight="Bold"/>
          <TextBlock Text="Choose a key" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,4"/>
          <TextBlock Text="KEY FILE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Choose key" Click="CryptoBrowseKey" Margin="8,0,0,0"/><TextBox x:Name="CryptoKey" AutomationProperties.Name="Disc key file"/></DockPanel>
          <TextBlock x:Name="CryptoKeyHelp" Text="For PS2 Classics, leave blank to use the placeholder key. Other files need their matching 16-byte klicensee. Only CEX is supported." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel></Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
  <Border x:Name="CryptoFooter" Grid.Row="3" Visibility="Collapsed" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="CONVERSION ACTIVITY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBox x:Name="CryptoStatus" Text="Ready" Height="105" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" AutomationProperties.Name="Conversion activity"/><TextBlock Text="CONVERSION PROGRESS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,9,0,5"/><ProgressBar x:Name="CryptoProgress" Style="{StaticResource ElectricProgress}" Height="14" IsIndeterminate="False" Foreground="{StaticResource AccentBrush}" Background="#223248" AutomationProperties.Name="Conversion progress"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="CryptoCancel" Content="Cancel" Click="CancelCrypto" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="CryptoRun" Content="Start conversion" Style="{StaticResource PrimaryButtonStyle}" Click="RunCrypto"/></StackPanel>
  </Grid></Border>
  <Border x:Name="BuilderFooter" Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="BUILD ACTIVITY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBox x:Name="Log" Height="105" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" AutomationProperties.Name="Build activity"/><DockPanel Margin="0,9,0,5"><TextBlock Text="BUILD PROGRESS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ProgressStatus" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="Waiting to build"/></DockPanel><ProgressBar x:Name="Progress" Style="{StaticResource ElectricProgress}" Height="14" IsIndeterminate="False" Foreground="{StaticResource AccentBrush}" Background="#223248" AutomationProperties.Name="Build progress"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="Cancel" Content="Cancel" Click="CancelBuild" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="Build" Style="{StaticResource PrimaryButtonStyle}" Content="Create PS4 package" Click="BuildPackage"/></StackPanel>
  </Grid></Border>
</Grid></Window>
