<Window x:Class="PS4Studio.ThemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" MaxHeight="560"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">
  <Border Margin="12" Background="#141F30" BorderBrush="#35516C" BorderThickness="1" CornerRadius="16" Padding="23">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16"><Border Width="34" Height="34" CornerRadius="11" Background="#153E56" Margin="0,0,12,0"><TextBlock Text="i" FontSize="19" FontWeight="Bold" Foreground="#39CEF5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
      <ScrollViewer Grid.Row="1" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="Message" Foreground="#CBD8E6" FontSize="14" LineHeight="21" TextWrapping="Wrap"/></ScrollViewer>
      <Button x:Name="Confirm" Grid.Row="2" Content="OK" Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" HorizontalAlignment="Right" Margin="0,22,0,0" IsDefault="True" IsCancel="True" Click="Confirm_Click"/>
    </Grid>
  </Border>
</Window>

