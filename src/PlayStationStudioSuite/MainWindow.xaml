<Window x:Class="ClassicsSuite.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" Title="PlayStation Classics Studio" Width="1200" Height="940" MinWidth="840" MinHeight="720" Background="{StaticResource Canvas}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" Icon="suite.ico">
  <Grid Margin="16,12,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="2,0,2,12"><Button DockPanel.Dock="Right" Content="About &amp; credits" Click="About"/><StackPanel><TextBlock Text="PLAYSTATION CLASSICS STUDIO" FontWeight="Bold" FontSize="11" Foreground="#55D6F7"/><TextBlock Text="Your classics, all in one place." FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></DockPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,10"><Button x:Name="Ps4Button" Content="PS4 Package Studio" Click="SelectPs4" Margin="0,0,8,4"/><Button x:Name="Ps3Button" Content="PS3 Package Studio" Click="SelectPs3" Margin="0,0,8,4"/><Button x:Name="CryptoButton" Content="PS2 &amp; PS3 Encrypt / Decrypt" Click="SelectCrypto" Margin="0,0,8,4"/><Button x:Name="MemoryButton" Content="PS2 Memory Card Studio" Click="SelectMemory" Margin="0,0,8,4"/><Button x:Name="Ps1MemoryButton" Content="PS1 Memory Card Studio" Click="SelectPs1Memory" Margin="0,0,8,4"/></WrapPanel>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#0C1421" CornerRadius="8" ClipToBounds="True"><Grid x:Name="Workspace"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <wfi:WindowsFormsHost x:Name="MainHost"/>
      <ScrollBar x:Name="WorkspaceHorizontal" Grid.Row="1" Orientation="Horizontal" Height="16" Minimum="0" Visibility="Collapsed" ValueChanged="WorkspaceScrollChanged"/>
      <ScrollBar x:Name="WorkspaceScroll" Grid.Column="1" Width="16" Minimum="0" Visibility="Collapsed" ValueChanged="WorkspaceScrollChanged"/>
      <TextBlock x:Name="Loading" Text="Preparing your studio…" Foreground="#9EADC0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid></Border>
    <TextBlock Grid.Row="3" x:Name="Status" Text="Ready" Foreground="#90A9BF" FontSize="11" Margin="4,8,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
