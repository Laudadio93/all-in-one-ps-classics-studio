<Window x:Class="ClassicsSuite.AboutDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="About PlayStation Classics Studio" Width="590" Height="530" MinWidth="440" MinHeight="360" WindowStartupLocation="CenterOwner" Background="#141F30" Foreground="{StaticResource Text}" FontFamily="Segoe UI" ShowInTaskbar="False">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="ABOUT" FontSize="11" FontWeight="Bold" Foreground="#55D6F7"/><TextBlock Text="PlayStation Classics Studio" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
      <TextBlock Text="The PS4 and PS3 package studios, PS2 and PS3 encryption tools, and PS1 and PS2 Memory Card Studios in one portable app." TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#CBD8E6"/>
      <TextBlock Text="Credits &amp; acknowledgments" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,10"/>
      <TextBlock Text="PS Classics fPKG Builder by SvenGDK and contributors. PS2 Classics GUI by Aldo Vargas and the ps3dev-net team. pop-fe by Ronnie Sahlberg and contributors. PS2 memory card tools are based on myMC and its contributors. PS1 memory-card layout is documented by the psx-spx project." TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="#CBD8E6"/>
      <TextBlock Text="Each studio contains its own About screen with detailed credits and relevant license notices. PS3 package studio notices and source materials can be viewed or saved below." TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="#CBD8E6" Margin="0,14,0,0"/>
      <TextBlock Text="PlayStation, PS2, PS3 and PS4 are products of Sony." TextWrapping="Wrap" Foreground="#9EADC0" Margin="0,18,0,0"/>
    </StackPanel></ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="0,18,0,0"><Button Content="View notices" Click="ViewNotices" Margin="0,0,8,4"/><Button Content="Save source archive" Click="SaveNotices" Margin="0,0,8,4"/><Button Content="Close" Click="CloseDialog" Margin="0,0,0,4"/></WrapPanel>
  </Grid>
</Window>
