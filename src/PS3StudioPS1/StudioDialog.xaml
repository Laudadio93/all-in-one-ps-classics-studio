<Window x:Class="PS2ClassicsPackageStudio.StudioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" MaxHeight="650" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Border Margin="8" Background="#141D2B" BorderBrush="#354A62" BorderThickness="1"
            CornerRadius="16" Padding="22">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" Opacity="0.45" ShadowDepth="3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="DialogTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="420" Margin="0,0,0,20">
                <TextBlock x:Name="DialogMessage" FontSize="13" Foreground="#C5D0DF" TextWrapping="Wrap"
                           TextOptions.TextFormattingMode="Display" />
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NoButton" Content="No" MinWidth="82" Margin="0,0,9,0" Click="No_Click" Visibility="Collapsed" />
                <Button x:Name="YesButton" Content="Yes" MinWidth="82" Click="Yes_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" />
                <Button x:Name="OkButton" Content="OK" MinWidth="82" Click="Ok_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
