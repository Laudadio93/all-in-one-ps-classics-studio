<Window x:Class="PS2ClassicsPackageStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS1 and PS2 Classics Package Studio"
        Icon="Resources/classics-package-icon.ico"
        Width="1160" Height="830" MinWidth="980" MinHeight="730"
        WindowStartupLocation="CenterScreen"
        Background="#0C1421"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#294158" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#20374C" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F1723" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                            <ContentPresenter Margin="11,0,40,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#E7EDF5" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="10" Height="5" Stretch="Fill" HorizontalAlignment="Right" Margin="0,0,14,0"
                                  VerticalAlignment="Center" IsHitTestVisible="False" />
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#192638" BorderBrush="#354A62" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="HeaderFrame" MinHeight="102">
            <Grid.Resources>
                <LinearGradientBrush x:Key="HeaderGlowBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform Angle="0" CenterX="0.5" CenterY="0.5" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#E6002D" Offset="0" />
                    <GradientStop Color="#FFCB05" Offset="0.25" />
                    <GradientStop Color="#00A99D" Offset="0.5" />
                    <GradientStop Color="#168BFA" Offset="0.75" />
                    <GradientStop Color="#E6002D" Offset="1" />
                </LinearGradientBrush>
            </Grid.Resources>
            <Border CornerRadius="14" BorderThickness="3" BorderBrush="{StaticResource HeaderGlowBrush}"
                    Opacity="0.65" IsHitTestVisible="False">
                <Border.Effect><BlurEffect Radius="9" /></Border.Effect>
            </Border>
        <Border CornerRadius="14" Padding="20,6" Background="#141F30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="44" VerticalAlignment="Center">
                    <Image Source="Resources/playstation-logo.png" Width="48" Height="44" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="PlayStation logo" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="PS1 + PS2 CLASSICS • PS3" Foreground="#66CDEA" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="PS1 and PS2 Classics Package Studio" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="Turn your own PS1 and PS2 disc images into PS3 Classics packages." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="About" MinWidth="112" HorizontalContentAlignment="Center" Padding="12,6"
                            Margin="0,0,0,6" Click="About_Click" />
                    <Border Background="#20354A" CornerRadius="8" Padding="12,7">
                        <TextBlock Text="LOCAL BUILD" Foreground="#A5DDF0" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
            <Border CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource HeaderGlowBrush}" IsHitTestVisible="False" />
        </Grid>

        <Grid Grid.Row="2" x:Name="InputPanels">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="01  DISC IMAGES" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Choose disc images" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                        <TextBlock Text="Add games to the queue and arrange their order." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,16,0,9">
                        <Button Content="＋  Add disc images" Click="AddDiscs_Click" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="#06121A" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiscCountText" Text="0 / 5 discs" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                    </DockPanel>
                    <ListBox x:Name="DiscList" SelectionChanged="DiscManualSelectionChanged" Grid.Row="2" SelectionMode="Single" AllowDrop="True" Drop="DiscList_Drop" DragOver="DiscList_DragOver">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#203348" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Number}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding FormatLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ImageSizeText" Text="No disc images selected" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="VerifyDiscButton" Content="Verify disc" Grid.Column="1" Padding="9,6" Margin="5,0,0,0" ToolTip="Compare supported PS1 and PS2 discs against offline Redump databases. Click again to cancel." Click="VerifyDisc_Click"/>
                        <Button Grid.Column="2" Content="↑" Padding="10,6" Margin="5,0,0,0" ToolTip="Move selected disc up" Click="MoveUp_Click" />
                        <Button Grid.Column="3" Content="↓" Padding="10,6" Margin="5,0,0,0" ToolTip="Move selected disc down" Click="MoveDown_Click" />
                        <Button Grid.Column="4" Content="Remove" Padding="10,6" Margin="5,0,0,0" Click="RemoveDisc_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="02  PACKAGE SETUP" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Choose where it goes" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                        <TextBlock Text="Save the finished .pkg to a folder on your computer." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />

                        <TextBlock Text="GAME SYSTEM" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="SystemChoice" Height="34" Style="{StaticResource DarkCombo}" SelectedIndex="1" SelectionChanged="SystemChoice_SelectionChanged"><ComboBoxItem Content="PS1 Classics"/><ComboBoxItem Content="PS2 Classics"/></ComboBox>
                        <TextBlock Text="BUILD MODE" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="BuildModeCombo" Height="34" Style="{StaticResource DarkCombo}" SelectedIndex="0" SelectionChanged="BuildModeChanged"
                                  Background="#0F1723" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}">
                            <ComboBoxItem Content="Separate packages" />
                            <ComboBoxItem Content="One multi-disc package" />
                        </ComboBox>
                        <TextBlock x:Name="OutputLabel" Text="PACKAGE FILE" Style="{StaticResource FieldLabelStyle}" />
                        <DockPanel>
                            <Button Content="Browse" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseOutput_Click" />
                            <TextBox x:Name="OutputPathBox" TextChanged="OutputPathBox_TextChanged" ToolTip="Full output path ending in .pkg" />
                        </DockPanel>

                        <TextBlock Text="PACKAGING ENGINE" Style="{StaticResource FieldLabelStyle}" />
                        <DockPanel>
                            <Button Content="CLI file" ToolTip="Select the pop-fe or pop-fe2 command-line engine for the chosen system" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseEngine_Click" />
                            <Button Content="Toolkit folder" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseKit_Click" />
                            <Button Content="Built-in" ToolTip="Use the built-in engine for the selected system" DockPanel.Dock="Right" Margin="8,0,0,0" Click="UseBuiltInEngine_Click" />
                            <TextBox x:Name="EnginePathBox" TextChanged="EnginePathBox_TextChanged" ToolTip="Extracted PS2 toolkit or selected command-line engine" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="1,7,0,0">
                            <Ellipse x:Name="EngineStatusDot" Width="7" Height="7" Fill="#D7A75F" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="EngineStatusText" Text="Choose the PS2 Classics CLI engine to enable building." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="KitOptions">
                            <TextBlock Text="PS3 GAME TITLE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="GameTitleBox" ToolTip="Leave blank to use the disc catalog or ISO filename" />
                            <TextBlock Text="Leave blank to use the disc catalog title." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="WidescreenOptions" Visibility="Collapsed">
                            <TextBlock Text="WIDESCREEN" Style="{StaticResource FieldLabelStyle}" />
                            <CheckBox x:Name="WidescreenCheck" Content="Apply a matching widescreen patch" />
                            <TextBlock Text="Experimental. Uses supported patches for the exact game version. Some games require runtime patches and will be skipped." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="CliOptions">
                        <StackPanel x:Name="MultiDiscOptions">
                        <TextBlock Text="MULTI-DISC" Style="{StaticResource FieldLabelStyle}" />
                        <CheckBox x:Name="SwapDiscCheck" Content="Enable in-game disc swapping" IsChecked="True" />
                        <TextBlock Text="Disc order in the list is the order written to the package." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Text="XMB FOCUS SOUND" Style="{StaticResource FieldLabelStyle}" />
                        <DockPanel>
                            <ComboBox x:Name="AudioModeCombo" Width="138" Height="34" Style="{StaticResource DarkCombo}" SelectionChanged="AudioModeCombo_SelectionChanged" SelectedIndex="0" Background="#0F1723" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}">
                                <ComboBoxItem Content="Automatic" />
                                <ComboBoxItem Content="No sound" />
                                <ComboBoxItem Content="Custom WAV" />
                            </ComboBox>
                            <Button x:Name="AudioBrowseButton" Content="Choose WAV" Margin="8,0,0,0" Click="BrowseAudio_Click" IsEnabled="False" />
                            <TextBlock x:Name="AudioFileText" Text="Uses catalog audio when available" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="9,0,0,0" />
                        </DockPanel>

                        </StackPanel>
                        <TextBlock Text="ARTWORK (OPTIONAL)" Style="{StaticResource FieldLabelStyle}" />
                        <CheckBox x:Name="AutoPs2ArtworkCheck" Content="Automatically find PS1 and PS2 cover artwork" IsChecked="True" Margin="0,0,0,6" Checked="ArtworkOptionChanged" Unchecked="ArtworkOptionChanged" />
                        <ComboBox x:Name="ArtworkStyleChoice" Height="34" Style="{StaticResource DarkCombo}" SelectedIndex="0" Margin="0,0,0,6" SelectionChanged="ArtworkOptionChanged"><ComboBoxItem Content="Standard cover"/><ComboBoxItem Content="3D cover"/></ComboBox>
                        <TextBlock x:Name="ArtworkStatusText" Text="Add a game to check for cover artwork." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button Content="Preview PS3 menu" HorizontalAlignment="Left" Margin="0,0,0,8" Click="PreviewXmb_Click"/>
                        <DockPanel><Button Content="Browse icon" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseCover_Click"/><TextBox x:Name="CoverPathBox" ToolTip="Optional package icon" TextChanged="ArtworkOptionChanged"/></DockPanel>
                        <DockPanel Margin="0,6,0,0"><Button Content="Browse background" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseBackdrop_Click"/><TextBox x:Name="BackdropPathBox" ToolTip="Optional PS3 background"/></DockPanel>
                        <Border x:Name="ArtworkPreviewFrame" Visibility="Collapsed" Background="#0B1522" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,8,0,0"><StackPanel Orientation="Horizontal"><Image x:Name="ArtworkPreviewImage" Width="75" Height="90" Stretch="Uniform"/><TextBlock x:Name="ArtworkPreviewCaption" Text="Cover preview" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></Border>
                        <TextBlock Text="Automatic cover lookup uses the internet. PS2 lookup uses the built-in engine or a compatible toolkit. Manual artwork takes priority. The PS1 engine may also look up artwork and audio." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock Text="COMPATIBILITY" Style="{StaticResource FieldLabelStyle}" />
                        <StackPanel><TextBlock Text="MANUALS · PC PREVIEW" Style="{StaticResource FieldLabelStyle}"/><DockPanel><Button Content="Choose manual" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseManual_Click"/><TextBox x:Name="ManualPathBox" ToolTip="Choose a manual for the selected system" TextChanged="ManualPathBox_TextChanged"/></DockPanel><Button x:Name="PreviewManualButton" Content="Open manual on this PC" Click="OpenManualPreview" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Text="Manuals stay on this PC. PS3 packages contain the game without the manual." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock x:Name="ManualHintText" Text="Select a disc or choose a manual to preview." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/><StackPanel x:Name="Ps2LibraryOptions"><CheckBox x:Name="OnlineManualCheck" Content="Find missing PS2 manuals online" IsChecked="True" Checked="OnlineManualCheck_Changed" Unchecked="OnlineManualCheck_Changed" Margin="0,8,0,0" ToolTip="Checks the Internet Archive for an exact game ID match and caches verified pages for offline reuse."/><TextBlock Text="PS2 MANUAL LIBRARY" Style="{StaticResource FieldLabelStyle}"/><DockPanel><Button Content="Choose folder" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseManualLibrary_Click"/><TextBox x:Name="ManualLibraryPathBox" TextChanged="ManualLibraryPathBox_TextChanged" ToolTip="Folder of PS2 manual ZIP or CBZ files named by game ID"/></DockPanel><TextBlock Text="Store image ZIP or CBZ manuals as the game ID, for example SLUS-20591.zip." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></StackPanel>
                        <StackPanel x:Name="Ps1Compat" Visibility="Collapsed"><CheckBox x:Name="Ps1NewEmuCheck" Content="Use alternate PS1 emulator (ps1_newemu)"/><TextBlock Text="Standard ps1_netemu and automatic game configs are used by default." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/><DockPanel Margin="0,6,0,0"><Button Content="Choose PS1 config" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowsePs1Config_Click"/><TextBox x:Name="Ps1ConfigPathBox" ToolTip="Optional .ps3config file for a single PS1 CUE disc"/></DockPanel><TextBlock Text="Optional .ps3config applies to one CUE disc. Existing sidecar configs remain supported by pop-fe." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel x:Name="Ps1PatchOptions" Visibility="Collapsed"><TextBlock Text="PS1 PATCH (OPTIONAL)" Style="{StaticResource FieldLabelStyle}"/><DockPanel><Button Content="Choose patch" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowsePs1Patch_Click"/><TextBox x:Name="Ps1PatchPathBox" ToolTip="Optional PPF2, PPF3 or xdelta patch for one single-BIN CUE"/></DockPanel><TextBlock Text="PPF2, PPF3 or xdelta for one single-BIN CUE. Your original disc stays unchanged." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel x:Name="Ps1ProtectionOptions" Visibility="Collapsed" Orientation="Horizontal" Margin="0,8,0,0" ToolTip="Blue: the bundled engine recognizes this ID in its LibCrypt database. Gray: the ID is unknown, not listed, or an external engine is selected. A missing entry does not establish that a game has no protection. SBI files are not imported."><Ellipse x:Name="Ps1ProtectionDot" Width="8" Height="8" Fill="#8999AE" Margin="0,0,6,0"/><TextBlock x:Name="Ps1ProtectionText" Text="Protection: waiting" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel x:Name="Ps2Compat"><TextBlock x:Name="Ps2ProfileStatusText" Text="Add a PS2 game to check bundled profiles." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="A profile is not a guarantee of compatibility. Selection applies to each queued game; a custom CONFIG takes priority." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/><ComboBox x:Name="Ps2ProfileChoice" Height="34" Style="{StaticResource DarkCombo}" SelectedIndex="0" Margin="0,6,0,0"><ComboBoxItem Content="Automatic"/><ComboBoxItem Content="CUSTOM"/><ComboBoxItem Content="NET"/><ComboBoxItem Content="GX"/><ComboBoxItem Content="SOFT"/><ComboBoxItem Content="No profile"/></ComboBox><DockPanel Margin="0,6,0,0"><Button Content="Choose CONFIG" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowsePs2Config_Click"/><TextBox x:Name="Ps2ConfigPathBox" ToolTip="Optional custom PS2 compatibility CONFIG file"/></DockPanel></StackPanel>
                        <Expander x:Name="Ps2AdvancedConfig" Header="Advanced PS2 config options" Margin="0,8,0,0" Foreground="{StaticResource TextBrush}"><StackPanel><TextBlock Text="Experimental: chosen options create a new CONFIG and replace the automatic profile. Use only when appropriate for the game." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,6"/><CheckBox x:Name="Ps2CacheFix" Content="Instruction cache setting (0x21)"/><CheckBox x:Name="Ps2PerformanceFix" Content="L2H performance setting (0x46)"/><CheckBox x:Name="Ps2PressureFix" Content="Pressure-sensitive controls (0x50)"/><TextBlock Text="MULTITAP" Style="{StaticResource FieldLabelStyle}"/><ComboBox x:Name="Ps2Multitap" Height="34" Style="{StaticResource DarkCombo}" SelectedIndex="0"><ComboBoxItem Content="Default"/><ComboBoxItem Content="Port 1"/><ComboBoxItem Content="Port 2"/></ComboBox></StackPanel></Expander>
                        <StackPanel x:Name="Ps2CompatibilityLink"><Button Content="Open PS2 compatibility reports" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenPs2Compatibility_Click"/><TextBlock Text="Online community reports are organized by title and region; review the matching version." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                        <Border Background="#10202E" BorderBrush="#244253" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,17,0,0">
                            <StackPanel>
                                <TextBlock Text="BUILD TARGET" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="TargetText" Text="PlayStation 3 · PS2 Classics · .PKG" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock Text="A compatible PS3 setup (HEN or CFW) is required to install and launch homebrew packages." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    <Button x:Name="BuildButton" Grid.Row="1" Content="Create PS3 Classics PKG" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Center" Margin="0,12,0,0" Click="Build_Click" IsEnabled="False" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource PanelStyle}" Padding="16,13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button x:Name="CancelButton" Content="Cancel build" DockPanel.Dock="Right" Padding="9,3" Click="Cancel_Click" Visibility="Collapsed" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="Green: PS1 audio tracks and their files are present.&#x0a;Red: A referenced audio file is missing.&#x0a;Gray: No audio tracks, no readable CUE, or a PS2 game.&#x0a;&#x0a;This does not test playback."><Ellipse x:Name="AudioCheckDot" Width="8" Height="8" Fill="#718196" Margin="0,0,5,0"/><TextBlock x:Name="AudioCheckLabel" Text="Disc audio: waiting" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="Green: Disc files and referenced PS1 tracks are present.&#x0a;Red: A file is missing or the CUE is invalid.&#x0a;Gray: Waiting for a disc.&#x0a;&#x0a;This does not verify dump integrity or gameplay."><Ellipse x:Name="DiscCheckDot" Width="8" Height="8" Fill="#718196" Margin="0,0,5,0"/><TextBlock x:Name="DiscCheckLabel" Text="Disc: waiting" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="Green: Artwork is available or manually selected.&#x0a;Red: Artwork was not found.&#x0a;Gray: Waiting, checking, disabled, or unavailable.&#x0a;&#x0a;Found artwork can be cached for offline use."><Ellipse x:Name="ArtworkCheckDot" Width="8" Height="8" Fill="#718196" Margin="0,0,5,0"/><TextBlock x:Name="ArtworkCheckLabel" Text="Artwork: waiting" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" ToolTip="Green: The selected manual is ready to preview on this PC.&#x0a;Red: No readable manual was found.&#x0a;Gray: Waiting or checking.&#x0a;You can build with any manual status."><Ellipse x:Name="ManualCheckDot" Width="8" Height="8" Fill="#718196" Margin="0,0,5,0"/><TextBlock x:Name="ManualCheckLabel" Text="Manual: waiting" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="BUILD ACTIVITY" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,3,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressStageText" Text="Ready" FontWeight="SemiBold" FontSize="15"
                               AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProgressDetailText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="ProgressPercentText" Grid.Column="2" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                               ToolTip="Estimated overall build progress" />
                </Grid>
                <ProgressBar x:Name="BuildProgressBar" Grid.Row="2" Height="8" Margin="0,0,0,3"
                             Foreground="{StaticResource AccentBrush}" Background="#29394D" Visibility="Collapsed"
                             AutomationProperties.Name="Overall package build progress" Minimum="0" Maximum="100">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track" SnapsToDevicePixels="True">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4" Background="{TemplateBinding Foreground}" />
                                <Border x:Name="Pulse" Visibility="Collapsed" CornerRadius="4" Background="{TemplateBinding Foreground}" Opacity="0.3" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                                    <Setter TargetName="Pulse" Property="Visibility" Value="Visible" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Name="PulseAnimation">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                                                 From="0.24" To="0.8" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <RemoveStoryboard BeginStoryboardName="PulseAnimation" />
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBox x:Name="LogText" Grid.Row="3" Margin="0,5,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Padding="10" Background="#0A111B" />
            </Grid>
        </Border>
    </Grid>
</Window>
